@page "/login"

@using EduSense.Shared
@inject HttpClient Http
@inject NavigationManager Navigation


<PageTitle>Login</PageTitle>

<div class="Login-container">

    <div class="Login-box">
        <h1>Login</h1>

        <p class="Login-text">
            Loggin to continue to EduSense.
        </p>

        <EditForm Model="@loginModel" OnValidSubmit="@LoginAsync">
            <DataAnnotationsValidator />
            
            <div class="form-group">
                <label for="username">Username</label>
                <InputText id="username" class="form-control" @bind-Value="loginModel.Username" />
                <ValidationMessage For="@(() => loginModel.Username)" />
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" />
                <ValidationMessage For="@(() => loginModel.Password)" />
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">
                    @errorMessage
                </div>
            }

            <button type="submit" class="login-button" disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Loggar in...</span>
                }
                else
                {
                    <span>Logga in</span>
                }
            </button>


            </EditForm>

        <a href="/forgot-password">
            Glömt lösenord?
        </a>
    </div>


</div>

@code {
    private LoginRequestDto loginModel = new();

    private string errorMessage = string.Empty;

    private bool isLoading = false;

    private async Task LoginAsync()
    {
        errorMessage = string.Empty;
        isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", loginModel);

            if(response.IsSuccessStatusCode)
            {
                // Login lyckades.
                // API:t har satt JWT som HTTP-Only cookie.

                Navigation.NavigateTo("/");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                // Ogiltiga inloggningsuppgifter.
                errorMessage = "Ogiltigt användarnamn eller lösenord.";
            }
            else
            {
                // Något annat gick fel.
                errorMessage = "Ett fel uppstod vid inloggning. Försök igen senare.";
            }
        }
        catch{
            errorMessage = "Ett fel uppstod vid inloggning. Försök igen senare.";
        }
        finally
        {
            isLoading = false;
        }
    }

}
