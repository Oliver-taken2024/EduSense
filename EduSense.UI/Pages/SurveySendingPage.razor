@page "/survey-sending"
@attribute [Authorize(Policy = "AdminOnly")]

@using EduSense.Shared
@using EduSense.UI.Services
@using System.ComponentModel.DataAnnotations
@inject ApiService ApiService
@inject NavigationManager Navigation


<PageTitle>Skicka enkät</PageTitle>

<a href="#main-content" class="skip-link">Hoppa till huvudinnehåll</a>

<button type="button" class="btn button-secondary back-link" @onclick='() => Navigation.NavigateTo("/")'>← Tillbaka</button>


<div class="page-header">
    <div>
        <h1>Enkätutskick</h1>
        <p class="page-subtitle">Bjud in respondenter och skicka enkät</p>
    </div>
</div>

<main id="main-content">
<!-- Visa status- och felmeddelanden om de finns -->
@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="alert alert-success" role="status">@_statusMessage</div>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (_isLoading)
    {
        <p role="status">Laddar enkäter...</p>
    }
    else
    {
        <!-- Formulär för att bjuda in respondenter -->

        <div class="card-panel mb-4">
            <h2 class="h5">Välj enkät</h2>
            <div class="mb-3">
                <label class="form-label" for="survey-select">Enkät</label>
                <select id="survey-select" class="form-select" @bind="_selectedSurveyId" @bind:after="OnSurveyChangedAsync">
                    <option value="0">Välj enkät</option>
                    @foreach (var survey in _surveys)
                    {
                        <option value="@survey.Id">@survey.Title</option>
                    }
                </select>
            </div>

        @if (_selectedSurveyId != 0)
        {
            <div class="mb-3">
                <label class="form-label" for="deadline">Sista svarsdatum</label>
                <input id="deadline" type="date" class="form-control" @bind="_responseDeadline" />
            </div>
        }
    </div>

    @if (_selectedSurveyId != 0)
    {
        <div class="card-panel mb-4">
            <h2 class="h5">Respondenter</h2>

                <div class="mb-3">
                    <label class="form-label" for="segment-select">Målgrupp för nya rader</label>
                    <select id="segment-select" class="form-select" @bind="_selectedSegment">
                        @foreach (var segment in Enum.GetValues<RespondentSegmentDto>())
                        {
                            <option value="@segment">@GetSegmentDisplayName(segment)</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="paste-area">Klistra in eller skriv e-postadresser (en per rad, eller kommaseparerat)</label>
                    <textarea id="paste-area" class="form-control" rows="4" @bind="_pasteText"></textarea>
                    <button type="button" class="btn button-secondary mt-2 button-add-from-paste" @onclick="ParsePastedEmails">
                        Lägg till
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table">
                            <caption class="visually-hidden">Lista över respondenter att bjuda in</caption>
                            <thead>
                                <tr>
                                    <th>E-post</th>
                                    <th>Målgrupp</th>
                                    <th><span class="visually-hidden">Åtgärder</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < _emails.Count; i++)
                                {
                                    var index = i;
                                    <tr>
                                        <td data-label="E-post">
                                            <label class="visually-hidden" for="@($"email-{index}")">E-postadress rad @(index + 1)</label>
                                            <input id="@($"email-{index}")" class="form-control" value="@_emails[index]"
                                            @oninput="e => _emails[index] = e.Value?.ToString() ?? string.Empty" />
                                        </td>
                                        <td data-label="Målgrupp">
                                            <label class="visually-hidden" for="@($"segment-{index}")">Målgrupp för rad @(index + 1)</label>
                                            <select id="@($"segment-{index}")" class="form-select" @bind="_segments[index]">
                                                @foreach (var segment in Enum.GetValues<RespondentSegmentDto>())
                                                {
                                                    <option value="@segment">@GetSegmentDisplayName(segment)</option>
                                                }
                                            </select>
                                        </td>
                                        <td data-label="Åtgärder">
                                            <button type="button" class="btn button-logout"
                                            aria-label="@($"Ta bort rad {index + 1}")"
                                            @onclick="() => RemoveRow(index)">
                                                Ta bort
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                <button type="button" class="btn button-secondary button-add-row" @onclick="AddEmptyRow">
                        + Lägg till rad
                    </button>

                    <div class="mt-3">
                        <button type="button" class="btn button-login" disabled="@(_isSending || _emails.Count == 0)"
                        @onclick="SendAsync">
                            @(_isSending ? "Skickar..." : "Skicka enkät")
                        </button>
                    </div>
                </div>
        }
    }
 </main>

 @code {

    private List<SurveyDto> _surveys = [];
    private int _selectedSurveyId = 0;
    private DateTime _responseDeadline = DateTime.Today.AddDays(30);
    private List<string> _emails = [];
    private List<RespondentSegmentDto> _segments = [];
    private RespondentSegmentDto _selectedSegment = RespondentSegmentDto.GradeFTo6;
    private string _pasteText = string.Empty;

    private bool _isLoading = true;
    private bool _isSending;
    private string? _statusMessage;
    private string? _errorMessage;

    // Hämtar listan över tillgängliga enkäter när sidan laddas

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _surveys = await ApiService.GetAsync<List<SurveyDto>>("api/survey") ?? [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Rensar e-postlistan när en ny enkät väljs
    private Task OnSurveyChangedAsync()
    {
        _emails = [];
        _segments = [];
        return Task.CompletedTask;
    }

    // Lägger till en tom rad i e-postlistan
    private void AddEmptyRow()
    {
        _emails.Add(string.Empty);
        _segments.Add(_selectedSegment);
    }

    // Tar bort en rad och håller e-post/segment i synk
    private void RemoveRow(int index)
    {
        _emails.RemoveAt(index);
        _segments.RemoveAt(index);
    }

    // Delar upp inklistrad text på nya rader och/eller komman, filtrerar bort tomma/dubbletter.
    private void ParsePastedEmails()
    {
        if (string.IsNullOrWhiteSpace(_pasteText))
        {
            return;
        }

        var parsed = _pasteText
            .Split(['\n', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(e => e.Contains('@'))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(e => !_emails.Contains(e, StringComparer.OrdinalIgnoreCase))
            .ToList();

        _emails.AddRange(parsed);
        _segments.AddRange(parsed.Select(_ => _selectedSegment));
        _pasteText = string.Empty;
    }

    private static string GetSegmentDisplayName(RespondentSegmentDto segment)
    {
        var member = typeof(RespondentSegmentDto).GetMember(segment.ToString())[0];
        var display = member.GetCustomAttributes(typeof(DisplayAttribute), false)
            .Cast<DisplayAttribute>()
            .FirstOrDefault();

        return display?.Name ?? segment.ToString();
    }

    // Skickar enkätutskicket till servern
    private async Task SendAsync()
    {
        _statusMessage = null;
        _errorMessage = null;
        _isSending = true;

        var dto = new SurveyDispatchSaveDto
        {
        SurveyId = _selectedSurveyId,
        ResponseDeadline = _responseDeadline,
        RespondentEmails = _emails
            .Select((email, index) => new RespondentInviteDto { Email = email, Segment = _segments[index] })
            .Where(e => !string.IsNullOrWhiteSpace(e.Email))
            .ToList()
        };

        try
        {
            await ApiService.PostAsync<SurveyDispatchDto>("api/surveydispatch", dto);
            _statusMessage = $"Enkäten skickades till {dto.RespondentEmails.Count} respondenter.";
            _emails = [];
            _segments = [];
        }
        catch (ApiException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors);
        }
        finally
        {
            _isSending = false;
        }
    }
}