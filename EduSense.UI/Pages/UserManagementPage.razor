@page "/user-management"
@attribute [Authorize(Policy = "AdminOnly")]
@using EduSense.Shared
@using EduSense.UI.Services
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Användarhantering</PageTitle>

<button type="button" class="btn button-secondary back-link" @onclick='() => Navigation.NavigateTo("/")'>← Tillbaka</button>

<div class="page-header">
    <div>
        <h1>Användarhantering</h1>
        <p class="page-subtitle">Bjud in, hantera och aktivera/inaktivera administratörer och analytiker</p>
    </div>
</div>

<!-- Visa status- och felmeddelanden om de finns -->
@if (!string.IsNullOrEmpty(_statusMessage))
{
    <div class="alert alert-success" role="status">@_statusMessage</div>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

<!-- Formulär för att bjuda in ny användare -->

<div class="card-panel mb-4">
    <h2 class="h5">Bjud in ny användare</h2>

    <EditForm Model="@_inviteModel" OnValidSubmit="HandleInviteSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary role="alert" />

        <!-- g-3 istället för g-2: fälten satt nästan ihop. sm-brytpunkter gör att
             e-post och roll delar rad redan på surfplatta i stället för att
             stapla hela vägen upp till 768px. -->
        <div class="row g-3 align-items-end">
            <div class="col-sm-7 col-lg-5">
                <label for="invite-email" class="form-label">E-postadress</label>
                <InputText id="invite-email" class="form-control" autocomplete="email" @bind-Value="_inviteModel.Email" />
            </div>
            <div class="col-sm-5 col-lg-4">
                <label for="invite-role" class="form-label">Roll</label>
                <InputSelect id="invite-role" class="form-select" @bind-Value="_inviteModel.Role">
                    <option value="Admin">Admin</option>
                    <option value="Analyst">Analytiker</option>
                </InputSelect>
            </div>
            <div class="col-lg-3">
                <button type="submit" class="btn button-login w-100" disabled="@_isInviting" aria-busy="@_isInviting">
                    @(_isInviting ? "Skickar..." : "Skicka inbjudan")
                </button>
            </div>
        </div>
    </EditForm>
</div>

<div class="card-panel">
    <!-- Sökfält för att filtrera användarlistan -->
    <div class="toolbar">
        <div class="toolbar-search">
            <label for="user-search" class="form-label">Sök</label>
            <input id="user-search" type="search" class="form-control" placeholder="Sök på användarnamn, e-post eller namn..."
                   @bind="_searchTerm" @bind:event="oninput" />
        </div>
        @if (!_isLoading && _users.Count > 0)
        {
            <p class="toolbar-meta">@FilteredUsers.Count av @_users.Count användare</p>
        }
    </div>

    <!-- Lista över användare -->
    @if (_isLoading)
    {
        <p role="status">Laddar användare...</p>
    }
    else if (_users.Count == 0)
    {
        <p>Inga användare hittades.</p>
    }
    else if (FilteredUsers.Count == 0)
    {
        <p>Inga användare matchar sökningen.</p>
    }
    else
    {
    <div class="table-responsive">
        <table class="table">
            <caption class="visually-hidden">Lista över admin- och analytikerkonton</caption>
            <thead>
                <tr>
                    <th>Användarnamn</th>
                    <th>E-post</th>
                    <th>Roll</th>
                    <th>Status</th>
                    <th><span class="visually-hidden">Åtgärder</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in FilteredUsers)
                {
                    <tr>
                        <td data-label="Användarnamn" class="cell-nowrap">@user.Username</td>
                        <td data-label="E-post" class="cell-nowrap">@user.Email</td>
                        <td data-label="Roll" class="cell-nowrap">@string.Join(", ", user.Roles)</td>
                        <td data-label="Status">
                            @if (!user.EmailConfirmed)
                            {
                                <span class="badge-status badge-status-pending">Väntar på svar</span>
                            }
                            else if (user.IsActive)
                            {
                                <span class="badge-status badge-status-active">Aktiv</span>
                            }
                            else
                            {
                                <span class="badge-status badge-status-inactive">Inaktiverad</span>
                            }
                        </td>
                        <td data-label="Åtgärder">
                            <div class="table-actions">
                                @if (!user.EmailConfirmed)
                                {
                                    <button type="button" class="btn button-secondary"
                                            @onclick="() => ResendInviteAsync(user)">
                                        Skicka inbjudan igen
                                    </button>
                                }
                                else if (user.IsActive)
                                {
                                    <button type="button" class="btn button-logout"
                                            @onclick="() => DeactivateAsync(user)">
                                        Inaktivera
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn button-login"
                                            @onclick="() => ActivateAsync(user)">
                                        Aktivera
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
</div>

@code {
    private List<UserListItemDto> _users = [];
    private readonly InviteUserRequestDto _inviteModel = new() { Role = "Analyst" };
    private string _searchTerm = string.Empty;

    // Filtrerar användarlistan på e-post eller namn utifrån sökfältet
    private List<UserListItemDto> FilteredUsers =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? _users
            : _users.Where(u =>
                u.Username.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                u.Email.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (u.DisplayName?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
              .ToList();

    // Variabler för att hantera formulärstatus och felmeddelanden
    private bool _isLoading = true;
    private bool _isInviting;
    private string? _statusMessage;
    private string? _errorMessage;

    // Ladda användare när komponenten initialiseras
    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    // Ladda användare från API:t och hantera eventuella fel
    private async Task LoadUsersAsync()
    {
        _isLoading = true;
        try
        {
            _users = await ApiService.GetAsync<List<UserListItemDto>>("api/users") ?? [];
        }
        catch (ApiException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors);
        }
        finally
        {
            _isLoading = false;
        }
    }
    // Hantera inbjudan av ny användare
    private async Task HandleInviteSubmit()
    {
        _statusMessage = null;
        _errorMessage = null;
        _isInviting = true;

        try
        {
            await ApiService.PostAsync("api/users/invite", _inviteModel);
            _statusMessage = $"Inbjudan skickad till {_inviteModel.Email}.";
            _inviteModel.Email = string.Empty;
            await LoadUsersAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors);
        }
        finally
        {
            _isInviting = false;
        }
    }
    // Hantera återutsändning av inbjudan
    private async Task ResendInviteAsync(UserListItemDto user)
    {
        _statusMessage = null;
        _errorMessage = null;

        try
        {
            await ApiService.PostAsync($"api/users/{user.Id}/resend-invite", new { });
            _statusMessage = $"Inbjudan skickad igen till {user.Email}.";
        }
        catch (ApiException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors);
        }
    }

    // Hantera inaktivering av användare
    private async Task DeactivateAsync(UserListItemDto user)
    {
        _statusMessage = null;
        _errorMessage = null;

        try
        {
            await ApiService.PostAsync($"api/users/{user.Id}/deactivate", new { });
            _statusMessage = $"{user.Email} är nu inaktiverad.";
            await LoadUsersAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors);
        }
    }

    // Hantera aktivering av användare
    private async Task ActivateAsync(UserListItemDto user)
    {
        _statusMessage = null;
        _errorMessage = null;

        try
        {
            await ApiService.PostAsync($"api/users/{user.Id}/activate", new { });
            _statusMessage = $"{user.Email} är nu aktiverad.";
            await LoadUsersAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors);
        }
    }
}