@page "/forgot-password"
@layout BlankLayout

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Glömt lösenord</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Glömt lösenord</h1>
        <p class="auth-subtitle">Ange din e-postadress så skickar vi en återställningslänk</p>

@if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="alert alert-success" role="status">@_statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }

        <div class="auth-field">
            <label for="forgot-email">E-postadress</label>
            <input id="forgot-email" type="email" class="form-control" autocomplete="email"
                   placeholder="namn@exempel.se" @bind="Email" />
        </div>

<button type="button" class="btn button-login"
        @onclick="SendReset"
        disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(Email))">
    @(_isSubmitting ? "Skickar..." : "Skicka återställning")
</button>

        <div class="auth-links">
            <a href="/login">Tillbaka till inloggning</a>
        </div>
    </div>
</div>


@code {
    private string Email = "";
    private string? _statusMessage;
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task SendReset()
    {

         _isSubmitting = true;
        _statusMessage = null;
        _errorMessage = null;

    try
        {
            var response = await Http.PostAsJsonAsync(
                "api/auth/forgot-password",
                new ForgotPasswordDto { Email = Email });

            if (response.IsSuccessStatusCode)
            {
                _statusMessage = "Om e-postadressen finns registrerad har en återställningslänk skickats.";
                Email = "";
            }
            else
            {
                _errorMessage = "Kunde inte skicka återställning just nu. Försök igen.";
            }
        }
        catch
        {
            _errorMessage = "Ett oväntat fel uppstod. Försök igen.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}