@page "/forgot-password"
@layout BlankLayout

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Glömt lösenord</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Glömt lösenord</h1>
        <p class="auth-subtitle">Ange din e-postadress så skickar vi en återställningslänk</p>

        <div class="auth-field">
            <label for="forgot-email">E-postadress</label>
            <input id="forgot-email" type="email" class="form-control" autocomplete="email"
                   placeholder="namn@exempel.se" @bind="Email" />
        </div>

        <button type="button" class="btn button-login" @onclick="SendReset">Skicka återställning</button>

        <div class="auth-links">
            <a href="/login">Tillbaka till inloggning</a>
        </div>
    </div>
</div>


@code {
    private string Email = "";

    private async Task SendReset()
    {
      var response = await Http.PostAsJsonAsync(

     "api/auth/forgot-password", new ForgotPasswordDto { Email = Email }); 

        if (response.IsSuccessStatusCode)
        {
          var token = await response.Content.ReadAsStringAsync();
          Navigation.NavigateTo($"/reset-password?email={Email}&token={Uri.EscapeDataString(token)}");
           
         }
    }

}
