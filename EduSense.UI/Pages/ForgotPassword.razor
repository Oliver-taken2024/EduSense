@page "/forgot-password"

@inject HttpClient Http
@inject NavigationManager Navigation

<h3>ForgotPassword</h3>

<input type="email" placeholder="Enter your email" @bind="Email" />

<button @onclick="SendReset">Skicka återställning</button>


@code {
    private string Email = "";

    private async Task SendReset()
    {
      var response = await Http.PostAsJsonAsync(

     "api/auth/forgot-password", new ForgotPasswordDto { Email = Email }); 

        if (response.IsSuccessStatusCode)
        {
          var token = await response.Content.ReadAsStringAsync();
          Navigation.NavigateTo($"/reset-password?email={Email}&token={Uri.EscapeDataString(token)}");
           
         }
    }

}
