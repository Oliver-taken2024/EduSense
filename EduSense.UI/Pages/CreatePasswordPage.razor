@page "/skapa-losenord"
@using EduSense.Shared
@using EduSense.UI.Services
@implements IDisposable
@inject ApiService ApiService
@inject NavigationManager NavigationManager

<PageTitle>Skapa lösenord</PageTitle>

<div class="container" style="max-width: 480px; margin-top: 3rem;">
    <h1>Skapa lösenord</h1>

    <!-- Kontrollera att nödvändiga parametrar finns i URL:en -->
    @if (_missingParameters)
    {
        <div class="alert alert-danger" role="alert">
            Länken saknar nödvändig information. Kontrollera att du klickade på hela länken i mejlet.
        </div>
    }
    else if (_success)
    {
        <div class="alert alert-success" role="status">
            Lösenordet är skapat. Du skickas vidare till inloggningen om några sekunder, eller klicka <a href="/login">här</a> för att logga in direkt.
        </div>
    }
    else
    {
        <!-- Formulär för att skapa ett nytt lösenord -->
        
        <EditForm Model="@_request" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary role="alert" />

            <div class="mb-3">
                <label for="new-password" class="form-label">Nytt lösenord</label>
                <InputText id="new-password"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           aria-describedby="password-help"
                           @bind-Value="_request.NewPassword" />
                <div id="password-help" class="form-text">Minst 8 tecken.</div>
            </div>

            <div class="mb-3">
                <label for="confirm-password" class="form-label">Bekräfta lösenord</label>
                <InputText id="confirm-password"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           aria-required="true"
                           aria-invalid="@(_errorMessage is not null)"
                           aria-describedby="@(_errorMessage is not null ? "confirm-password-error" : null)"
                           @bind-Value="_confirmPassword" />
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div id="confirm-password-error" class="alert alert-danger" role="alert">@_errorMessage</div>
            }

            <button type="submit" class="btn btn-primary" disabled="@_isSubmitting" aria-busy="@_isSubmitting">
                @(_isSubmitting ? "Sparar..." : "Skapa lösenord")
            </button>
        </EditForm>
    }
</div>

@code {
    private const int RedirectDelaySeconds = 3;

    // Hämta userId och token från URL:en

    [SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    // Skapa en instans av SetInitialPasswordRequestDto för att binda formulärdata
    private readonly SetInitialPasswordRequestDto _request = new();
    // Variabler för att hantera formulärstatus och felmeddelanden
    private string _confirmPassword = string.Empty;
    private string? _errorMessage;
    private bool _isSubmitting;
    private bool _success;
    private bool _missingParameters;
    private CancellationTokenSource? _redirectCts;

    // Kontrollera att nödvändiga parametrar finns och initiera _request med userId och token
    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
        {
            _missingParameters = true;
            return;
        }

        _request.UserId = UserId;
        _request.Token = Token;
    }
    // Hantera formulärinlämning
    private async Task HandleValidSubmit()
    {
        _errorMessage = null;

        if (_request.NewPassword != _confirmPassword)
        {
            _errorMessage = "Lösenorden matchar inte.";
            return;
        }

        _isSubmitting = true;
        try
        {
            // Skicka en POST-förfrågan till API:t för att skapa lösenordet

            await ApiService.PostAsync("api/auth/set-initial-password", _request);
            _success = true;
            StateHasChanged();

            _redirectCts = new CancellationTokenSource();
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(RedirectDelaySeconds), _redirectCts.Token);
                NavigationManager.NavigateTo("/login");
            }
            catch (TaskCanceledException)
            {
                // Komponenten hann tas bort (typ användaren navigerade bort manuellt) - avbryt tyst.
            }
        }
        catch (ApiException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public void Dispose()
    {
        // Avbryt eventuell väntan på omdirigering om komponenten tas bort innan fördröjningen är klar
        _redirectCts?.Cancel();
        _redirectCts?.Dispose();
    }
}