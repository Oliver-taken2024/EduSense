@page "/login"
@* BlankLayout istället för standardlayouten: annars ritas den tomma sidomenyn
   (250px) även på inloggningsskärmen, och kortet centreras mot ytan efter
   menyn i stället för mot skärmen. *@
@layout BlankLayout

@using EduSense.Shared
@using EduSense.UI.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject CookieAuthenticationStateProvider AuthStateProvider


<PageTitle>Logga in</PageTitle>

<div class="auth-page">

    <div class="auth-card">
        <img src="/Images/MainLogo.png" alt="EduSense" class="auth-logo" />

        <h1>Logga in</h1>
        <p class="auth-subtitle">Logga in för att hantera enkäter och resultat</p>

        <EditForm Model="@loginRequest" OnValidSubmit="@LoginAsync">
            <DataAnnotationsValidator />

            <div class="auth-field">
                <label for="username">Användarnamn</label>
                <InputText id="username" class="form-control" autocomplete="username" @bind-Value="loginRequest.Username" />
                <ValidationMessage For="@(() => loginRequest.Username)" />
            </div>
            <div class="auth-field">
                <label for="password">Lösenord</label>
                <InputText id="password" type="password" class="form-control" autocomplete="current-password" @bind-Value="loginRequest.Password" />
                <ValidationMessage For="@(() => loginRequest.Password)" />
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-error" role="alert">
                    @errorMessage
                </div>
            }

            <button type="submit" class="btn button-login" disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Loggar in...</span>
                }
                else
                {
                    <span>Logga in</span>
                }
            </button>
        </EditForm>

        <div class="auth-links">
            <a href="/forgot-password">Glömt lösenord?</a>
        </div>
    </div>

</div>

@code {
    private LoginRequestDto loginRequest = new();

    private string errorMessage = string.Empty;

    private bool isLoading = false;

    private async Task LoginAsync()
    {
        errorMessage = string.Empty;
        isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", loginRequest);

            if(response.IsSuccessStatusCode)
            {
                // Login lyckades. API:t har satt JWT + refresh-token som httpOnly-cookies.
                // Tala om för Blazor att auth-statusen kan ha ändrats, så AuthorizeRouteView
                // frågar api/auth/me på nytt istället för att fortsätta tro att vi är utloggade.
                AuthStateProvider.NotifyAuthenticationChanged();

                
                //en återställ lösenord sida 
                //register sida
                //API uppdatar lösenord 
                //API glömt lösenord 

                Navigation.NavigateTo("/");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                // Ogiltiga inloggningsuppgifter.
                errorMessage = "Ogiltigt användarnamn eller lösenord.";
            }
            else
            {
                // Något annat gick fel.
                errorMessage = "Ett fel uppstod vid inloggning. Försök igen senare.";
            }
        }
        catch{
            errorMessage = "Ett fel uppstod vid inloggning. Försök igen senare.";
        }
        finally
        {
            isLoading = false;
        }
    }

}
