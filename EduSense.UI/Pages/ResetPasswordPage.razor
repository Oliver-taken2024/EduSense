@page "/reset-password"

@inject ApiService Api
@inject NavigationManager Navigation

<h1>ResetPassword</h1>



@if (_success) 
{
<div class="alert alert-success" role="status">
   
    Lösenordet har uppdaterats.
    
    Du skickas till inloggningen om några sekunder.
    
</div>

}

else

{
    
    <input type="password" aria-required="true" aria-describedby="password-help" placeholder="Nytt lösenord" @bind="NewPassword" />
<br />

<input type="password" aria-required="true"
           aria-invalid="@(!string.IsNullOrEmpty(ErrorMessage))"
           aria-describedby="@(!string.IsNullOrEmpty(ErrorMessage) ? "confirm-password-error" : null)"
           placeholder="Bekräfta lösenord" @bind="ConfirmPassword" />
<br />
    <button @onclick="ResetPasswordAsync" disabled="@_isSubmitting">
        @(_isSubmitting ? "Byter lösenord..." : "Byt lösenord")
    </button>
    
}

@if (!string.IsNullOrEmpty(ErrorMessage))    
{
    <p style="color:red">@ErrorMessage</p>
}
@code {
    private bool _isSubmitting;

    private bool _success;

    private const int RedirectDelaySeconds = 3;

    private CancellationTokenSource? _redirectCts;

    [SupplyParameterFromQuery]
    public string Email { get; set; } = "";

    [SupplyParameterFromQuery]
    public string Token { get; set; } = "";

    private string NewPassword = "";

    private string ConfirmPassword = "";

    private string ErrorMessage = "";


    private async Task ResetPasswordAsync()
    {
        ErrorMessage = "";

        if (NewPassword != ConfirmPassword) {
            ErrorMessage = "Lösenorden matchar inte.";
            return;
        }
        if (NewPassword.Length < 8)
        {
            ErrorMessage = "Lösenordet måste vara minst 8 tecken långt.";
            return;
        }

        if (!NewPassword.Any(char.IsUpper))
        {

            ErrorMessage = "Lösenordet måste innehålla minst en stor bokstav.";
            return;
        }
        if (!NewPassword.Any(char.IsLower))
        {
            ErrorMessage = "Lösenordet måste innehålla minst en liten bokstav.";
            return;
        }
        if (!NewPassword.Any(char.IsDigit)) {
            ErrorMessage = "Lösenordet måste innehålla minst en siffra.";
            return;
        }
        if (NewPassword.All(char.IsLetterOrDigit)) {
            ErrorMessage = "Lösenordet måste innehålla minst ett specialtecken.";
            return;
        }
        
        
            _isSubmitting = true;
        try
        {
            await Api.PostAsync("api/auth/reset-password", new ResetPasswordDto
            {
                Email = Email,
                Token = Token,
                NewPassword = NewPassword
            });

            _success = true;
            StateHasChanged();

            _redirectCts = new CancellationTokenSource();
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(RedirectDelaySeconds), _redirectCts.Token);
                Navigation.NavigateTo("/login");
            }
            catch (TaskCanceledException)
            {
                // Komponenten hann tas bort (typ användaren navigerade bort manuellt) - avbryt tyst.
            }
        }
        finally
        {
            _isSubmitting = false;
        }

        try
        {
            ErrorMessage = "Kunde inte återställa lösenordet. Länken kan ha gått ut eller redan använts.";
        }
        finally
        {
            
        _isSubmitting = false;
            
        }    
    }
    }