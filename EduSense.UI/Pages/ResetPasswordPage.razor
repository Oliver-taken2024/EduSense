@page "/reset-password"
@layout BlankLayout

@inject ApiService Api
@inject NavigationManager Navigation

<PageTitle>Byt lösenord</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <h1>Byt lösenord</h1>

        @if (_success)
        {
            <div class="alert alert-success" role="status">
                Lösenordet har uppdaterats. Du skickas till inloggningen om några sekunder.
            </div>
        }
        else
        {
            <p class="auth-subtitle">Minst 8 tecken, med stor och liten bokstav, siffra och specialtecken</p>

            <div class="auth-field">
                <label for="new-password">Nytt lösenord</label>
                <input id="new-password" type="password" class="form-control" autocomplete="new-password"
                       aria-required="true" @bind="NewPassword" />
            </div>
            <div class="auth-field">
                <label for="confirm-password">Bekräfta lösenord</label>
                <input id="confirm-password" type="password" class="form-control" autocomplete="new-password"
                       aria-required="true"
                       aria-invalid="@(!string.IsNullOrEmpty(ErrorMessage))"
                       aria-describedby="@(!string.IsNullOrEmpty(ErrorMessage) ? "confirm-password-error" : null)"
                       @bind="ConfirmPassword" />
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div id="confirm-password-error" class="auth-error" role="alert">@ErrorMessage</div>
            }

            <button type="button" class="btn button-login" @onclick="ResetPasswordAsync" disabled="@_isSubmitting">
                @(_isSubmitting ? "Byter lösenord..." : "Byt lösenord")
            </button>
        }

        <div class="auth-links">
            <a href="/login">Tillbaka till inloggning</a>
        </div>
    </div>
</div>
@code {
    private bool _isSubmitting;

    private bool _success;

    private const int RedirectDelaySeconds = 3;

    private CancellationTokenSource? _redirectCts;

    [SupplyParameterFromQuery]
    public string Email { get; set; } = "";

    [SupplyParameterFromQuery]
    public string Token { get; set; } = "";

    private string NewPassword = "";

    private string ConfirmPassword = "";

    private string ErrorMessage = "";

    private async Task ResetPasswordAsync()
    {
        ErrorMessage = "";

        if (NewPassword != ConfirmPassword) {
            ErrorMessage = "Lösenorden matchar inte.";
            return;
        }
        if (NewPassword.Length < 8)
        {
            ErrorMessage = "Lösenordet måste vara minst 8 tecken långt.";
            return;
        }

        if (!NewPassword.Any(char.IsUpper))
        {

            ErrorMessage = "Lösenordet måste innehålla minst en stor bokstav.";
            return;
        }
        if (!NewPassword.Any(char.IsLower))
        {
            ErrorMessage = "Lösenordet måste innehålla minst en liten bokstav.";
            return;
        }
        if (!NewPassword.Any(char.IsDigit)) {
            ErrorMessage = "Lösenordet måste innehålla minst en siffra.";
            return;
        }
        if (NewPassword.All(char.IsLetterOrDigit)) {
            ErrorMessage = "Lösenordet måste innehålla minst ett specialtecken.";
            return;
        }


        _isSubmitting = true;
        try
        {
            await Api.PostAsync("api/auth/reset-password", new ResetPasswordDto
            {
                Email = Email,
                Token = Token,
                NewPassword = NewPassword
            });

            _success = true;
            StateHasChanged();

            _redirectCts = new CancellationTokenSource();
            await Task.Delay(TimeSpan.FromSeconds(RedirectDelaySeconds), _redirectCts.Token);
            Navigation.NavigateTo("/login");
        }
        catch (ApiException)
        {
            ErrorMessage = "Kunde inte återställa lösenordet. Länken kan ha gått ut eller redan använts.";
        }
        catch (TaskCanceledException)
        {
                    // Komponenten hann tas bort (typ användaren navigerade bort manuellt) - avbryt tyst.
        }
        finally
        {
            _isSubmitting = false;
        }
    }
 }