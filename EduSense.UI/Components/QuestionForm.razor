<div class="fade-in-up">
    <h2 class="h5">@(IsEditing ? "Redigera fråga" : "Ny fråga")</h2>

    <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
        <div class="mb-3">
            <label class="form-label" for="questionText">Frågetext</label>
            <input id="questionText" class="form-control" @bind="_text" @bind:event="oninput" />
        </div>

        @if (!IsEditing)
        {
            <div class="mb-3">
                <span class="form-label" id="answerScaleLabel">Svarsskala</span>
                <div role="radiogroup" aria-labelledby="answerScaleLabel">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="scaleStandard" name="answerScale"
                               checked="@(!_isNps)" @onchange="() => _isNps = false" />
                        <label class="form-check-label" for="scaleStandard">Standard (1–5, nöjdhetsskala)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="scaleNps" name="answerScale"
                               checked="@_isNps" @onchange="() => _isNps = true" />
                        <label class="form-check-label" for="scaleNps">NPS (1–10, rekommendationsfråga)</label>
                    </div>
                </div>
                <div class="form-text">Skalan sätts vid skapande och går inte att ändra senare.</div>
            </div>
        }

        @if (_errors.Count > 0)
        {
            <ul class="text-danger" role="alert">
                @foreach (var error in _errors)
                {
                    <li>@error</li>
                }
            </ul>
        }

        <div class="form-actions">
            <button type="submit" class="btn button-login" disabled="@_isSaving">Spara</button>
            <button type="button" class="btn button-secondary" @onclick="Cancel">Avbryt</button>
        </div>
    </form>
</div>

@using System.Security.Claims
@code {
    [Parameter] public QuestionDto? Question { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    [Inject] private ApiService Api { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;

    private bool IsEditing => Question is not null && Question.Id != 0;

    private string _text = string.Empty;
    private bool _isNps;
    private List<string> _errors = [];
    private bool _isSaving;
    private int? _loadedQuestionId;

    protected override void OnParametersSet()
    {
        if (Question?.Id == _loadedQuestionId)
        {
            return;
        }

        _loadedQuestionId = Question?.Id;
        _text = Question?.Text ?? string.Empty;
        _isNps = false;
    }

    private async Task SaveAsync()
    {
        _errors = [];
        _isSaving = true;

        // Skapad-av ska vara den faktiskt inloggade användaren, inte ett manuellt fält.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var createdByUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        var dto = new QuestionDto
        {
            Id = Question?.Id ?? 0,
            Text = _text,
            CreatedByUserId = IsEditing ? Question?.CreatedByUserId ?? string.Empty : createdByUserId,
            Organisation = Question?.Organisation,
            IsNps = _isNps
        };

        try
        {
            if (IsEditing)
            {
                await Api.PutAsync<QuestionDto>($"api/Question/{Question!.Id}", dto);
            }
            else
            {
                await Api.PostAsync<QuestionDto>("api/Question", dto);
            }

            await OnSaved.InvokeAsync();
        }
        catch (ApiException ex)
        {
            _errors = ex.Errors.ToList();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task Cancel()
    {
        await OnCancelled.InvokeAsync();
    }
}