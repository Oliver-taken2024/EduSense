@* Schematisk geografisk fördelning - punkter placerade efter relativ lat/long, ingen riktig kartkälla. *@

@if (_points.Count == 0)
{
    <p>Ingen geografisk data.</p>
}
else
{
    <svg viewBox="0 0 300 200" width="100%" height="220" role="img" aria-label="Geografisk fördelning">
        <defs>
            @* Mjuk skugga under punkterna så kartan känns lite mer "3D" istället för platta cirklar. *@
            <filter id="geoPointShadow" x="-50%" y="-50%" width="200%" height="200%">
                <feDropShadow dx="0" dy="1" stdDeviation="1.5" flood-color="#000" flood-opacity="0.35" />
            </filter>
        </defs>

        <rect x="0" y="0" width="300" height="200" fill="var(--geo-bg, #f1f3f5)" rx="8" />

        @* Diskreta hjälplinjer, samma variabel som TrendChart använder för sina axlar -
           ger kartan lite djup utan att dra uppmärksamhet från punkterna. *@
        @for (var gx = 0; gx <= 4; gx++)
        {
            var x = 10 + gx * 70;
            <line x1="@x" y1="10" x2="@x" y2="190" stroke="var(--trend-gridline, #e5e7eb)" stroke-width="1" />
        }
        @for (var gy = 0; gy <= 3; gy++)
        {
            var y = 10 + gy * 60;
            <line x1="10" y1="@y" x2="290" y2="@y" stroke="var(--trend-gridline, #e5e7eb)" stroke-width="1" />
        }

        @foreach (var point in _points)
        {
            <circle class="geo-point"
                    cx="@point.X.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                    cy="@point.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                    r="@point.Radius.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                    fill="@point.Color"
                    fill-opacity="0.85"
                    stroke="@point.Color"
                    stroke-width="1.5"
                    filter="url(#geoPointShadow)">
                <title>@point.Name: snitt @point.AverageScore.ToString("0.0")</title>
            </circle>
            @* <text> är ett Razor-reserverat taggnamn - kan inte ha @-bundna attribut direkt,
               så positioneringen läggs på en <g transform="..."> runt omkring istället. *@
            <g transform="@($"translate({point.X.ToString(System.Globalization.CultureInfo.InvariantCulture)},{(point.Y - point.Radius - 4).ToString(System.Globalization.CultureInfo.InvariantCulture)})")">
                <text text-anchor="middle" class="geo-label">@point.Name</text>
            </g>
        }
    </svg>

    @* Synlig färgförklaring - matchar ColorFor(). Håller kartan begriplig utan
       att man behöver gissa vad grönt/gult/rött betyder. *@
    <ul class="geo-legend">
        <li><span class="donut-swatch" style="background:#2f9e44"></span> Snitt ≥ 4</li>
        <li><span class="donut-swatch" style="background:#f59f00"></span> Snitt 3–4</li>
        <li><span class="donut-swatch" style="background:#c92a2a"></span> Snitt &lt; 3</li>
    </ul>

    @* Textekvivalent till kartan (WCAG 1.1.1/1.4.1) - betyget kodas annars bara via cirkelns
       färg (grön/gul/röd) och storlek, osynligt för skärmläsare och otydligt för färgblinda. *@
    <ul class="visually-hidden">
        @foreach (var point in _points.OrderByDescending(p => p.AverageScore))
        {
            <li>@point.Name: snitt @point.AverageScore.ToString("0.0"), @point.RespondentCount svar</li>
        }
    </ul>
}

@code {
    [Parameter] public IReadOnlyList<OrganisationLocationDto> Locations { get; set; } = [];

    private List<GeoPoint> _points = [];

    protected override void OnParametersSet()
    {
        var withCoords = Locations.Where(l => l.Latitude.HasValue && l.Longitude.HasValue).ToList();

        if (withCoords.Count == 0)
        {
            _points = [];
            return;
        }

        var minLat = withCoords.Min(l => l.Latitude!.Value);
        var maxLat = withCoords.Max(l => l.Latitude!.Value);
        var minLng = withCoords.Min(l => l.Longitude!.Value);
        var maxLng = withCoords.Max(l => l.Longitude!.Value);
        var minScore = withCoords.Min(l => l.AverageScore);
        var maxScore = withCoords.Max(l => l.AverageScore);

        _points = withCoords.Select(l =>
        {
            var x = maxLng == minLng ? 150.0 : 20 + (l.Longitude!.Value - minLng) / (maxLng - minLng) * 260;
            // Högre latitud (norrut) ska hamna högre upp på bilden, dvs mindre y-värde.
            var y = maxLat == minLat ? 100.0 : 20 + (maxLat - l.Latitude!.Value) / (maxLat - minLat) * 160;
            // Tidigare 8-18px var för stort för det 300x200-fältet, särskilt med fler
            // organisationer nära varandra geografiskt - krympt till 4-10px.
            var radius = 4 + (maxScore == minScore ? 3 : (l.AverageScore - minScore) / (maxScore - minScore) * 6);

            return new GeoPoint(l.OrganisationName, x, y, radius, ColorFor(l.AverageScore), l.AverageScore, l.RespondentCount);
        }).ToList();
    }

    private static string ColorFor(double averageScore) => averageScore switch
    {
        >= 4 => "#2f9e44",
        >= 3 => "#f59f00",
        _ => "#c92a2a"
    };

    private record GeoPoint(string Name, double X, double Y, double Radius, string Color, double AverageScore, int RespondentCount);
}
