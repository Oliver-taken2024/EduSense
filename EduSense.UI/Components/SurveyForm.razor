<div class="fade-in-up">
<h4>@(IsEditing ? "Redigera enkät" : "Ny enkät")</h4>

<form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
    <div class="mb-3">
        <label class="form-label" for="title">Titel</label>
        <input id="title" class="form-control" @bind="_title" @bind:event="oninput" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="expiryDate">Sista svarsdatum</label>
        <input id="expiryDate" type="date" class="form-control" @bind="_surveyExpiryDate" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="organisation">Organisation</label>
        <select id="organisation" class="form-select" @bind="_organisationId">
            <option value="0">Välj organisation</option>
            @foreach (var org in Organisations)
            {
                <option value="@org.Id">@org.Name</option>
            }
        </select>
    </div>

    @if (!IsEditing)
    {
        <div class="mb-3">
            <label class="form-label" for="createdByUserId">Skapad av (user id) — tillfälligt fält tills inloggning finns</label>
            <input id="createdByUserId" class="form-control" @bind="_createdByUserId" @bind:event="oninput" />
        </div>
    }

    <fieldset class="mb-3">
        <legend class="form-label">Frågor</legend>
        @foreach (var question in Questions)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="@($"question-{question.Id}")"
                       checked="@_selectedQuestionIds.Contains(question.Id)"
                       @onchange="@(e => ToggleQuestion(question.Id, (bool)e.Value!))" />
                <label class="form-check-label" for="@($"question-{question.Id}")">@question.Text</label>
            </div>
        }
    </fieldset>

    @if (_errors.Count > 0)
    {
        <ul class="text-danger" role="alert">
            @foreach (var error in _errors)
            {
                <li>@error</li>
            }
        </ul>
    }

    <button type="submit" class="btn button-login" disabled="@_isSaving">Spara</button>
    <button type="button" class="btn btn-secondary" @onclick="Cancel">Avbryt</button>
</form>
</div>

@code {
    [Parameter] public SurveyDto? Survey { get; set; }
    [Parameter] public IReadOnlyList<OrganisationDto> Organisations { get; set; } = [];
    [Parameter] public IReadOnlyList<QuestionDto> Questions { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    [Inject] private ApiService Api { get; set; } = default!;

    private bool IsEditing => Survey is not null;

    private string _title = string.Empty;
    private DateTime _surveyExpiryDate = DateTime.Today;
    private int _organisationId;
    private string _createdByUserId = string.Empty;
    private HashSet<int> _selectedQuestionIds = [];
    private List<string> _errors = [];
    private bool _isSaving;
    private int? _loadedSurveyId;

    protected override void OnParametersSet()
    {
        if (Survey?.Id == _loadedSurveyId)
        {
            return;
        }

        _loadedSurveyId = Survey?.Id;

        if (Survey is null)
        {
            _title = string.Empty;
            _surveyExpiryDate = DateTime.Today;
            _organisationId = 0;
            _createdByUserId = string.Empty;
            _selectedQuestionIds = [];
        }
        else
        {
            _title = Survey.Title;
            _surveyExpiryDate = Survey.SurveyExpiryDate;
            _organisationId = Survey.OrganisationId;
            _selectedQuestionIds = Survey.SurveyQuestions.Select(q => q.QuestionId).ToHashSet();
        }
    }

    private void ToggleQuestion(int questionId, bool isSelected)
    {
        if (isSelected)
        {
            _selectedQuestionIds.Add(questionId);
        }
        else
        {
            _selectedQuestionIds.Remove(questionId);
        }
    }

    private async Task SaveAsync()
    {
        _errors = [];
        _isSaving = true;

        var dto = new SurveySaveDto
        {
            Title = _title,
            SurveyExpiryDate = _surveyExpiryDate,
            OrganisationId = _organisationId,
            CreatedByUserId = _createdByUserId,
            QuestionIds = _selectedQuestionIds.ToList()
        };

        try
        {
            if (IsEditing)
            {
                await Api.PutAsync<SurveyDto>($"api/Survey/{Survey!.Id}", dto);
            }
            else
            {
                await Api.PostAsync<SurveyDto>("api/Survey", dto);
            }

            await OnSaved.InvokeAsync();
        }
        catch (ApiException ex)
        {
            _errors = ex.Errors.ToList();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task Cancel()
    {
        await OnCancelled.InvokeAsync();
    }
}