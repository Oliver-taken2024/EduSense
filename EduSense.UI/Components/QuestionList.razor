<div class="fade-in-up">
<div class="toolbar">
    <div class="toolbar-search">
        <label for="questionFilter" class="form-label">Sök</label>
        <input id="questionFilter" type="search" class="form-control" placeholder="Sök fråga..." value="@_filterText" @oninput="OnFilterChanged" />
    </div>
    @if (Questions.Count > 0)
    {
        <p class="toolbar-meta">@FilteredQuestions.Count av @Questions.Count frågor</p>
    }
</div>

@if (FilteredQuestions.Count == 0)
{
    <p>Inga frågor hittades.</p>
}
else
{
    <div class="table-responsive">
    <table class="table">
        <caption class="visually-hidden">Lista över frågor</caption>
        <thead>
            <tr>
                <th>Text</th>
                <th>Organisation</th>
                <th>Skapad av</th>
                <th>Skapad</th>
                <th><span class="visually-hidden">Åtgärder</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var question in PagedQuestions)
            {
                <tr>
                    <td data-label="Text" class="col-text">@question.Text</td>
                    <td data-label="Organisation" class="cell-nowrap">@question.Organisation?.Name</td>
                    <td data-label="Skapad av" class="cell-nowrap cell-muted">@question.CreatedByEmail</td>
                    <td data-label="Skapad" class="cell-nowrap cell-muted">@question.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td data-label="Åtgärder">
                        <div class="table-actions">
                            <button type="button" class="btn button-login"
                                    aria-label="@($"Redigera frågan {question.Text}")" @onclick="() => OnEdit.InvokeAsync(question)">
                                <img src="/Images/Edit.png" alt="" width="14" height="14" /> Redigera
                            </button>
                            <button type="button" class="btn button-copy"
                                    aria-label="@($"Kopiera frågan {question.Text}")" @onclick="() => OnCopy.InvokeAsync(question)">
                                Kopiera
                            </button>
                            <button type="button" class="btn button-logout"
                                    aria-label="@($"Ta bort frågan {question.Text}")" @onclick="() => OnDelete.InvokeAsync(question.Id)">
                                <img src="/Images/Delete.png" alt="" width="14" height="14" /> Ta bort
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <Pagination TotalItems="FilteredQuestions.Count" PageSize="PageSize" CurrentPage="_currentPage" CurrentPageChanged="page => _currentPage = page" ItemLabel="frågor" />
}
</div>

@code {
    [Parameter] public IReadOnlyList<QuestionDto> Questions { get; set; } = [];
    [Parameter] public EventCallback<QuestionDto> OnEdit { get; set; }
    [Parameter] public EventCallback<QuestionDto> OnCopy { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private const int PageSize = 7;
    private string _filterText = string.Empty;
    private int _currentPage = 1;

    private IReadOnlyList<QuestionDto> FilteredQuestions =>
        string.IsNullOrWhiteSpace(_filterText)
            ? Questions
            : Questions.Where(q => q.Text.Contains(_filterText, StringComparison.OrdinalIgnoreCase)).ToList();

    private IReadOnlyList<QuestionDto> PagedQuestions =>
        FilteredQuestions.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();

    private void OnFilterChanged(ChangeEventArgs e)
    {
        _filterText = e.Value?.ToString() ?? string.Empty;
        // Börja om på sida 1 - annars kan man fastna på en sida som inte
        // längre finns när filtreringen krymper resultatet.
        _currentPage = 1;
    }
}
