<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Enkäter</h4>
    <button type="button" class="btn button-login" @onclick="() => OnCreateNew.InvokeAsync()">
        Ny enkät
    </button>
</div>

@if (Surveys.Count == 0)
{
    <p>Inga enkäter ännu.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Organisation</th>
                <th>Sista svarsdatum</th>
                <th>Antal frågor</th>
                <th><span class="visually-hidden">Åtgärder</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var survey in Surveys)
            {
                <tr>
                    <td>@survey.Title</td>
                    <td>@survey.Organisation?.Name</td>
                    <td>@survey.SurveyExpiryDate.ToString("yyyy-MM-dd")</td>
                    <td>@survey.SurveyQuestions.Count</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                aria-label="@($"Redigera enkäten {survey.Title}")" @onclick="() => OnEdit.InvokeAsync(survey)">
                            <img src="/Images/Edit.png" alt="" width="14" height="14" /> Redigera
                        </button>
                        <button type="button" class="btn btn-sm button-logout"
                                aria-label="@($"Ta bort enkäten {survey.Title}")" @onclick="() => OnDelete.InvokeAsync(survey.Id)">
                            <img src="/Images/Delete.png" alt="" width="14" height="14" /> Ta bort
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public IReadOnlyList<SurveyDto> Surveys { get; set; } = [];
    [Parameter] public EventCallback<SurveyDto> OnEdit { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback OnCreateNew { get; set; }
}