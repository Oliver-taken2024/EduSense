<div class="fade-in-up">
<div class="mb-3">
    <label for="surveyFilter" class="visually-hidden">Sök enkät</label>
    <input id="surveyFilter" class="form-control" placeholder="Sök enkäter..." value="@_filterText" @oninput="OnFilterChanged" />
</div>

@if (FilteredSurveys.Count == 0)
{
    <p>Inga enkäter hittades.</p>
}
else
{
    <div class="table-responsive">
    <table class="table">
        <caption class="visually-hidden">Lista över enkäter</caption>
        <thead>
            <tr>
                <th>Titel</th>
                <th>Organisation</th>
                <th>Sista svarsdatum</th>
                <th>Antal frågor</th>
                <th><span class="visually-hidden">Åtgärder</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var survey in PagedSurveys)
            {
                <tr>
                    <td>@survey.Title</td>
                    <td>@survey.Organisation?.Name</td>
                    <td>@survey.SurveyExpiryDate.ToString("yyyy-MM-dd")</td>
                    <td>@survey.SurveyQuestions.Count</td>
                    <td>
                        <div class="table-actions">
                            <button type="button" class="btn btn-sm button-login"
                                    aria-label="@($"Redigera enkäten {survey.Title}")" @onclick="() => OnEdit.InvokeAsync(survey)">
                                <img src="/Images/Edit.png" alt="" width="14" height="14" /> Redigera
                            </button>
                            <button type="button" class="btn btn-sm button-logout"
                                    aria-label="@($"Ta bort enkäten {survey.Title}")" @onclick="() => OnDelete.InvokeAsync(survey.Id)">
                                <img src="/Images/Delete.png" alt="" width="14" height="14" /> Ta bort
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <Pagination TotalItems="FilteredSurveys.Count" PageSize="PageSize" CurrentPage="_currentPage" CurrentPageChanged="page => _currentPage = page" ItemLabel="enkäter" />
}
</div>

@code {
    [Parameter] public IReadOnlyList<SurveyDto> Surveys { get; set; } = [];
    [Parameter] public EventCallback<SurveyDto> OnEdit { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private const int PageSize = 7;
        public readonly object OnCreateNew;
        private string _filterText = string.Empty;
    private int _currentPage = 1;

    private IReadOnlyList<SurveyDto> FilteredSurveys =>
        string.IsNullOrWhiteSpace(_filterText)
            ? Surveys
            : Surveys.Where(s => s.Title.Contains(_filterText, StringComparison.OrdinalIgnoreCase)).ToList();

    private IReadOnlyList<SurveyDto> PagedSurveys =>
        FilteredSurveys.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();

    private void OnFilterChanged(ChangeEventArgs e)
    {
        _filterText = e.Value?.ToString() ?? string.Empty;
        // Börja om på sida 1 - annars kan man fastna på en sida som inte
        // längre finns när filtreringen krymper resultatet.
        _currentPage = 1;
    }
}
