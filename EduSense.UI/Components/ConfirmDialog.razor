@implements IAsyncDisposable
@inject IJSRuntime JS

@if (IsVisible)
{
    <div id="@_modalId" class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="confirmDialogTitle"
    aria-describedby="confirmDialogMessage" @onkeydown="HandleKeyDown" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content background2 pop-modal">
                <div class="modal-header">
                    <h5 id="confirmDialogTitle" class="modal-title">@Title</h5>
                </div>
                <div class="modal-body">
                    <p id="confirmDialogMessage">@Message</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"  @ref="_cancelButtonRef" @onclick="() => OnCancelled.InvokeAsync()">
                        Avbryt
                    </button>
                    <button type="button" class="btn button-logout" @onclick="() => OnConfirmed.InvokeAsync()">
                        <img src="/Images/Delete.png" alt="" width="14" height="14" /> Ta bort
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }

    private readonly string _modalId = $"confirmDialog-{Guid.NewGuid():N}";
    private ElementReference _cancelButtonRef;
    private bool _previouslyVisible;

    [Parameter] public string Title { get; set; } = "Bekräfta";
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public EventCallback OnConfirmed { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && !_previouslyVisible)
        {
            await _cancelButtonRef.FocusAsync();
            await JS.InvokeVoidAsync("eduSenseFocusTrap.trap", _modalId);
        }
        else if (!IsVisible && _previouslyVisible)
        {
            await JS.InvokeVoidAsync("eduSenseFocusTrap.release");
        }

        _previouslyVisible = IsVisible;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnCancelled.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_previouslyVisible)
        {
            await JS.InvokeVoidAsync("eduSenseFocusTrap.release");
        }
    }
}
