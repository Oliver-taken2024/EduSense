@using EduSense.UI.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject CookieAuthenticationStateProvider AuthStateProvider

<nav class="floating-nav" aria-label="Huvudmeny">
    <NavLink class="floating-nav-link" href="" Match="NavLinkMatch.All" title="Hem" aria-label="Hem">
        <span class="floating-nav-icon"><span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span></span>
        <span class="floating-nav-label">Hem</span>
    </NavLink>

    <AuthorizeView Roles="Admin">
        <NavLink class="floating-nav-link" href="user-management" Match="NavLinkMatch.All" title="Användarhantering" aria-label="Användarhantering">
            <span class="floating-nav-icon"><span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span></span>
            <span class="floating-nav-label">Användare</span>
        </NavLink>
        <NavLink class="floating-nav-link" href="question-management" Match="NavLinkMatch.All" title="Frågehantering" aria-label="Frågehantering">
            <span class="floating-nav-icon"><span class="bi bi-question-circle-fill-nav-menu" aria-hidden="true"></span></span>
            <span class="floating-nav-label">Frågor</span>
        </NavLink>
        <NavLink class="floating-nav-link" href="survey-management" Match="NavLinkMatch.All" title="Enkäthantering" aria-label="Enkäthantering">
            <span class="floating-nav-icon"><span class="bi bi-clipboard-fill-nav-menu" aria-hidden="true"></span></span>
            <span class="floating-nav-label">Enkäter</span>
        </NavLink>
        <NavLink class="floating-nav-link" href="survey-sending" Match="NavLinkMatch.All" title="Enkätutskick" aria-label="Enkätutskick">
            <span class="floating-nav-icon"><span class="bi bi-send-fill-nav-menu" aria-hidden="true"></span></span>
            <span class="floating-nav-label">Utskick</span>
        </NavLink>
    </AuthorizeView>

    <AuthorizeView Roles="Admin,Analyst">
        <NavLink class="floating-nav-link" href="results" Match="NavLinkMatch.All" title="Resultat" aria-label="Resultat">
            <span class="floating-nav-icon"><span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span></span>
            <span class="floating-nav-label">Resultat</span>
        </NavLink>
    </AuthorizeView>

    <AuthorizeView>
        <Authorized>
            <div class="floating-nav-divider" aria-hidden="true"></div>
            <button type="button" class="floating-nav-link floating-nav-logout" @onclick="LogoutAsync" disabled="@_isLoggingOut"
                    title="@GetUserTooltip(context)" aria-label="@GetUserTooltip(context)">
                <span class="floating-nav-icon"><span class="bi bi-arrow-right-from-bracket-nav-menu" aria-hidden="true"></span></span>
                <span class="floating-nav-label">Logga ut</span>
            </button>
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    private bool _isLoggingOut;

    private async Task LogoutAsync()
    {
        _isLoggingOut = true;

        try
        {
            // Tar bort refresh-token-raden i DB + rensar båda httpOnly-cookierna server-side.
            await Http.PostAsync("api/auth/logout", null);
        }
        catch
        {
            // Även om anropet misslyckas (t.ex. redan utloggad) - fortsätt logga ut lokalt.
        }
        finally
        {
            _isLoggingOut = false;
        }

        // forceLoad: true - full sidladdning istället för SPA-navigering.
        // Undviker en krock där NotifyAuthenticationChanged() fortfarande
        // uppdaterar auth-state medan navigeringen redan hunnit montera ner
        // navbaren (gav en NullReferenceException). En hel omstart av
        // WASM-appen läser dessutom in rätt (utloggat) auth-state från scratch.
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    // Namn + roll visas inte i själva knappen (etiketten är alltid bara "Logga ut",
    // se navbarens fasta etiketter) - fullständig info finns i title/aria-label istället.
    private static string GetUserTooltip(Microsoft.AspNetCore.Components.Authorization.AuthenticationState state)
    {
        var name = state.User.FindFirst("display_name")?.Value ?? "Användare";
        var role = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Användare";
        return $"{name} ({role}) - Logga ut";
    }
}
